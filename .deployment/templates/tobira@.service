[Unit]
Description=Tobira %i
Documentation=https://github.com/elan-ev/tobira

After=local-fs.target
After=network.target
After=postgresql.service
After=meili.service

[Service]
WorkingDirectory=/opt/tobira/%i/
ExecStart=/opt/tobira/%i/tobira serve
Restart=always
User=tobira

[Install]
WantedBy=multi-user.target
